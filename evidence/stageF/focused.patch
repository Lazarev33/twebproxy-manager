+  check "$CASE_ID.no-backup" 'no backup started' no_backup
+  check "$CASE_ID.no-leftovers" 'candidate and staging removed' no_leftovers
+  check "$CASE_ID.lock" 'lock released' f_lock_free
+  f_case_cleanup
+fi
