+[[ -z "$file" || ! -f "$F_REMOTE/fault/$rest" ]] || fault="$(<"$F_REMOTE/fault/$rest")"
+[[ "$fault" != hang ]] || exec sleep 3600
+size=0; [[ -z "$file" ]] || size="$(stat -c %s "$file")"
+if [[ -n "$maxsize" ]] && (( size > maxsize )); then echo 'curl: (63) Maximum file size exceeded' >&2; exit 63; fi
