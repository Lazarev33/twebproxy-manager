+      'Имя профиля/секрета') printf '%s' "${C1_NAME:-$2}";;
+      'MTProxy backend port') printf '%s' "${C1_BACKEND_PORT:-$2}";;
+      'MTProxy stats port') printf '%s' "${C1_STATS_PORT:-$2}";;
+      'Max connections на worker') c1_barrier "${C1_AT_MAXCONN:-}"; printf '%s' "$2";;
+      *) printf '%s' "$2";;
