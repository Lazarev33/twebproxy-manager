+#!/usr/bin/env bash
+# F05 regression: concurrent mutations of the same instance are serialized, the
+# state read for a read-modify-write is the state under the lock (no lost
+# update), port allocation is serialized from choice to persistence, locks are
+# released on failure, and an unrelated instance is not blocked.
+#
+# Deterministic: each race parks one process at a barrier inside an
+# interactive prompt (before any lock is taken), runs the competitor to
+# completion, then releases the barrier. No timing assumptions beyond bounded
+# waits.
+set -uo pipefail
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
+MGR="${1:-$ROOT/twebproxy-manager.sh}"
+TMP="$(mktemp -d /tmp/twebproxy-c1-race.XXXXXX)"
+trap 'kill $(jobs -p) 2>/dev/null; rm -rf -- "$TMP"' EXIT
+export ROOT MGR TMP
+source "$ROOT/tests/stagec1/state-harness.sh"
+c1_harness
+pass=0; fail=0
+ok() { printf 'PASS %s\n' "$*"; pass=$((pass+1)); }
+bad() { printf 'FAIL %s\n' "$*" >&2; fail=$((fail+1)); }
+check() { local name="$1"; shift; if "$@"; then ok "$name"; else bad "$name"; fi; }
+A=alpha.example; B=bravo.example
+pf() { printf '%s/%s/profiles.d/%s.env' "$INSTANCES_DIR" "$1" "$2"; }
+lockfile() { printf '%s/.locks/instance-%s.lock' "$BASE_DIR" "$1"; }
+all_backend_ports() { cat "$BACKENDS_DIR"/*.env | sed -n 's/^MTPROXY_\(CLIENT\|STATS\)_PORT=//p' | sort; }
+reset_state() {
+  rm -rf "$INSTANCES_DIR" "$BACKENDS_DIR" "$TMP"/*.reached "$TMP"/*.go "$SITES_DIR"
+  install -d -m 0700 "$INSTANCES_DIR" "$BACKENDS_DIR"; install -d -m 0755 "$SITES_DIR"
+  c1_seed_instance "$A" 18080 18081; c1_seed_instance "$B" 18082 18083
+  c1_seed_profile "$A" alpha aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa https 23980 28980
+  c1_seed_profile "$B" bravo bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb https 23981 28981
+  c1_run rebuild_profiles_json "$A" >/dev/null 2>&1; c1_run rebuild_profiles_json "$B" >/dev/null 2>&1
+}
+# Background operation parked at barrier $1; remaining args are the command.
+park() { local b="$1"; shift; c1_run "$@" > "$TMP/$b.out" 2>&1 & echo $! > "$TMP/$b.pid"; c1_wait_reached "$b"; }
+release() { : > "$TMP/$1.go"; wait "$(cat "$TMP/$1.pid")"; echo $? > "$TMP/$1.rc"; }
+show() { grep -E '\[(x|!)\]' "$1" | tail -n 2 | sed 's/^/  | /'; }
+
+# 1. lost update: carrier change parked at its prompt, secret rotation completes.
+reset_state
+C1_AT_CARRIER=carrier C1_CARRIER=websocket park carrier profile_carrier_cmd "$A" alpha
+check race1_parked test -e "$TMP/carrier.reached"
+C1_SECRET=cccccccccccccccccccccccccccccccc c1_run profile_rotate_cmd "$A" alpha > "$TMP/rotate.out" 2>&1; rc=$?
+check race1_rotation_completes test "$rc" -eq 0
+release carrier
+check race1_carrier_completes test "$(cat "$TMP/carrier.rc")" -eq 0
+check race1_rotated_secret_survives test "$(c1_field "$(pf "$A" alpha)" SECRET)" = cccccccccccccccccccccccccccccccc
+check race1_carrier_applied test "$(c1_field "$(pf "$A" alpha)" CARRIER_MODE)" = websocket
+check race1_backend_matches_record test "$(c1_field "$BACKENDS_DIR/$A--alpha.env" MTPROXY_SECRET)" = cccccccccccccccccccccccccccccccc
+
+# 2. port allocation: an add parked after choosing ports, a second add on
+#    another instance completes; the parked one must not reuse those ports.
+reset_state
+C1_AT_MAXCONN=addA C1_NAME=second park addA profile_add_cmd "$A"
+C1_NAME=other c1_run profile_add_cmd "$B" > "$TMP/addB.out" 2>&1; rc=$?
+check race2_competitor_completes test "$rc" -eq 0
+release addA
+check race2_parked_completes test "$(cat "$TMP/addA.rc")" -eq 0
+check race2_backend_ports_unique test -z "$(all_backend_ports | uniq -d)"
+check race2_four_profiles_present test "$(ls "$BACKENDS_DIR"/*.env | wc -l)" = 4
+
+# 3. manual ports chosen before a competitor took them: refused, nothing overwritten.
+reset_state
+C1_AT_MAXCONN=manual C1_NAME=manual C1_MANUAL_PORTS=1 C1_BACKEND_PORT=24100 C1_STATS_PORT=29100 park manual profile_add_cmd "$A"
+C1_NAME=taker C1_MANUAL_PORTS=1 C1_BACKEND_PORT=24100 C1_STATS_PORT=29100 c1_run profile_add_cmd "$B" > "$TMP/taker.out" 2>&1; rc=$?
+check race3_competitor_completes test "$rc" -eq 0
+release manual
+check race3_conflict_refused test "$(cat "$TMP/manual.rc")" -ne 0
+show "$TMP/manual.out"
+check race3_no_record test ! -e "$(pf "$A" manual)"
+check race3_competitor_backend_intact test "$(c1_field "$BACKENDS_DIR/$B--taker.env" MTPROXY_CLIENT_PORT)" = 24100
+check race3_ports_unique test -z "$(all_backend_ports | uniq -d)"
+
+# 4. same profile name added concurrently: the late one refuses, no overwrite.
+reset_state
+C1_AT_MAXCONN=dupA C1_NAME=gamma C1_SECRET=11111111111111111111111111111111 park dupA profile_add_cmd "$A"
+C1_NAME=gamma C1_SECRET=22222222222222222222222222222222 c1_run profile_add_cmd "$A" > "$TMP/dupB.out" 2>&1
+release dupA
+check race4_late_duplicate_refused test "$(cat "$TMP/dupA.rc")" -ne 0
+show "$TMP/dupA.out"
+check race4_first_secret_kept test "$(c1_field "$(pf "$A" gamma)" SECRET)" = 22222222222222222222222222222222
+
+# 5. same hostname added concurrently: the late one refuses, no overwrite.
+reset_state
+C1_AT_MAXCONN=instA C1_HOST=delta.example C1_NAME=first C1_SECRET=33333333333333333333333333333333 C1_INSTANCE_STUBS=1 park instA add_instance_cmd
+C1_HOST=delta.example C1_NAME=winner C1_SECRET=44444444444444444444444444444444 C1_INSTANCE_STUBS=1 c1_run add_instance_cmd > "$TMP/instB.out" 2>&1; rc=$?
+check race5_competitor_completes test "$rc" -eq 0
+release instA
+check race5_late_instance_refused test "$(cat "$TMP/instA.rc")" -ne 0
+show "$TMP/instA.out"
+check race5_winner_profile_kept test "$(c1_field "$(pf delta.example winner)" SECRET)" = 44444444444444444444444444444444
+check race5_no_late_profile test ! -e "$(pf delta.example first)"
+check race5_ports_unique test -z "$(all_backend_ports | uniq -d)"
+
+# 6. contention: a held instance lock makes a mutation wait and then fail closed.
+reset_state
+install -d -m 0700 "$BASE_DIR/.locks"
+before="$(cat "$(pf "$A" alpha)")"
+exec {holder}>>"$(lockfile "$A")"; flock "$holder"
+start=$SECONDS
+TWEBPROXY_STATE_LOCK_WAIT=1 C1_SECRET=55555555555555555555555555555555 c1_run profile_rotate_cmd "$A" alpha > "$TMP/busy.out" 2>&1; rc=$?
+check contention_fails_closed test "$rc" -ne 0
+check contention_bounded_wait test "$((SECONDS - start))" -le 10
+check contention_state_unchanged test "$(cat "$(pf "$A" alpha)")" = "$before"
+check contention_reports_busy grep -qiE 'busy|занят|lock' "$TMP/busy.out"
+show "$TMP/busy.out"
+# 7. an unrelated instance is not blocked by that lock.
+TWEBPROXY_STATE_LOCK_WAIT=1 C1_SECRET=66666666666666666666666666666666 c1_run profile_rotate_cmd "$B" bravo > "$TMP/other.out" 2>&1; rc=$?
+check independent_instance_not_blocked test "$rc" -eq 0
+exec {holder}>&-
+TWEBPROXY_STATE_LOCK_WAIT=1 C1_SECRET=77777777777777777777777777777777 c1_run profile_rotate_cmd "$A" alpha >/dev/null 2>&1; check after_release_mutation_succeeds test $? -eq 0
+
+# 8. a failed mutation releases its locks; nothing stays held.
+: > "$TMP/fail-validate"
+C1_SECRET=88888888888888888888888888888888 c1_run profile_rotate_cmd "$A" alpha > "$TMP/failed.out" 2>&1; rc=$?
+rm -f "$TMP/fail-validate"
+check failed_mutation_reported test "$rc" -ne 0
+show "$TMP/failed.out"
+check failed_mutation_released_instance_lock flock -n "$(lockfile "$A")" true
+check failed_mutation_released_port_lock bash -c '[[ ! -e "$1" ]] || flock -n "$1" true' _ "$BASE_DIR/.locks/ports.lock"
+TWEBPROXY_STATE_LOCK_WAIT=1 C1_SECRET=99999999999999999999999999999999 c1_run profile_rotate_cmd "$A" alpha >/dev/null 2>&1; check repeated_invocation_after_failure test $? -eq 0
+check lock_files_private test "$(stat -c '%a:%u' "$BASE_DIR/.locks" "$(lockfile "$A")" | sort -u | paste -sd' ')" = "600:0 700:0"
+
+printf 'c1-concurrency: pass=%s fail=%s\n' "$pass" "$fail"
+(( fail == 0 ))
diff --git a/tests/stagec1/port-allocation-fixture.sh b/tests/stagec1/port-allocation-fixture.sh
new file mode 100644
index 0000000..375572f
--- /dev/null
+++ b/tests/stagec1/port-allocation-fixture.sh
@@ -0,0 +1,79 @@
+#!/usr/bin/env bash
+# F13 regression: an occupied port is never reported free. v0.2.13 used
+# `ss | awk | grep -q` under pipefail: grep -q exiting at the first match makes
+# awk die of SIGPIPE, the pipeline fails, and a listening port looks free; a
+# failing ss looked like "nothing listens". Ports recorded only in profiles.d
+# (backend env missing after an interrupted commit) were not seen either.
+set -uo pipefail
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
+MGR="${1:-$ROOT/twebproxy-manager.sh}"
+TMP="$(mktemp -d /tmp/twebproxy-c1-ports.XXXXXX)"
+trap 'rm -rf -- "$TMP"' EXIT
+source "$ROOT/tests/stagec1/state-harness.sh"
+c1_harness
+pass=0; fail=0
+ok() { printf 'PASS %s\n' "$*"; pass=$((pass+1)); }
+bad() { printf 'FAIL %s\n' "$*" >&2; fail=$((fail+1)); }
+check() { local name="$1"; shift; if "$@"; then ok "$name"; else bad "$name"; fi; }
+listening() { c1_run port_listening "$1" >/dev/null 2>&1; }
+free() { c1_run port_available "$1" >/dev/null 2>&1; }
+not() { ! "$@"; }
+H=alpha.example
+
+# 1. SIGPIPE: the matching listener comes first, then a large listener table.
+printf 'LISTEN 0 4096 0.0.0.0:23980 0.0.0.0:*\n' > "$TMP/ss-extra"
+export C1_SS_PAD=200000
+check sigpipe_listening_port_detected listening 23980
+check sigpipe_listening_port_not_free not free 23980
+for i in 1 2 3; do check "sigpipe_repeat_$i" listening 23980; done
+unset C1_SS_PAD
+
+# 2. listener formats (IPv4, IPv6, wildcard, mapped, scoped).
+cat > "$TMP/ss-extra" <<'EOF'
+LISTEN 0 4096 [::]:23990 [::]:*
+LISTEN 0 4096 *:23991 *:*
+LISTEN 0 4096 [::ffff:127.0.0.1]:23992 *:*
+LISTEN 0 4096 127.0.0.1%lo:23993 0.0.0.0:*
+LISTEN 0 4096 0.0.0.0:23994 0.0.0.0:*
+LISTEN 0 4096 [fe80::1%eth0]:23995 [::]:*
+LISTEN 0 4096 *:8080 *:*
+EOF
+for p in 23990 23991 23992 23993 23994 23995 8080; do check "format_listening_$p" listening "$p"; done
+check format_absent_port_free free 23996
+check format_suffix_is_not_port not listening 80
+check format_prefix_is_not_port not listening 2399
+
+# 3. ss failure is not proof that a port is free.
+: > "$TMP/fail-ss"
+c1_run port_listening 23996 > "$TMP/out" 2>&1; rc=$?
+check ss_failure_not_listening_unknown test "$rc" -ne 0 -a "$rc" -ne 1
+check ss_failure_port_not_free not free 23996
+check ss_failure_reported grep -qi 'ss' "$TMP/out"
+c1_run next_free_port 23996 23999 > "$TMP/out" 2>/dev/null; rc=$?
+check ss_failure_allocation_refused test "$rc" -ne 0 -a -z "$(cat "$TMP/out")"
+rm -f "$TMP/fail-ss"
+
+# 4. ports recorded in the authoritative profile record count as registered.
+c1_seed_instance "$H" 18080 18081
+c1_seed_profile "$H" alpha aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa https 24500 29500
+rm -f "$BACKENDS_DIR/$H--alpha.env"
+: > "$TMP/ss-extra"
+check profile_record_backend_port_registered not free 24500
+check profile_record_stats_port_registered not free 29500
+check instance_relay_port_registered not free 18080
+check unrelated_port_free free 24501
+
+# 5. allocation skips registered and listening ports, returns a free one.
+printf 'LISTEN 0 4096 [::]:24501 [::]:*\n' > "$TMP/ss-extra"
+check next_free_skips_taken test "$(c1_run next_free_port 24500 24510)" = 24502
+
+# 6. backend readiness is found despite a large listener table (no SIGPIPE flake).
+c1_seed_profile "$H" alpha aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa https 24500 29500
+: > "$TMP/ss-extra"
+start=$SECONDS
+C1_SS_PAD=200000 c1_run start_profile_backend "$H" alpha > "$TMP/out" 2>&1; rc=$?
+check readiness_detected_with_large_table test "$rc" -eq 0
+check readiness_without_retry_loop test "$((SECONDS - start))" -le 8
+
+printf 'c1-port-allocation: pass=%s fail=%s\n' "$pass" "$fail"
+(( fail == 0 ))
diff --git a/tests/stagec1/profile-identity-fixture.sh b/tests/stagec1/profile-identity-fixture.sh
new file mode 100644
index 0000000..adb2c0a
--- /dev/null
+++ b/tests/stagec1/profile-identity-fixture.sh
@@ -0,0 +1,84 @@
+#!/usr/bin/env bash
+# F03 regression: creating, rotating, re-carrying or showing one profile must
+# never target another. v0.2.13 rebuild_profiles_json sourced every profile into
+# the caller's shell, so profile_add_cmd went on to start, report and show the
+# alphabetically last profile instead of the new one.
+set -uo pipefail
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
+MGR="${1:-$ROOT/twebproxy-manager.sh}"
+TMP="$(mktemp -d /tmp/twebproxy-c1-identity.XXXXXX)"
+trap 'rm -rf -- "$TMP"' EXIT
+source "$ROOT/tests/stagec1/state-harness.sh"
+c1_harness
+pass=0; fail=0
+ok() { printf 'PASS %s\n' "$*"; pass=$((pass+1)); }
+bad() { printf 'FAIL %s\n' "$*" >&2; fail=$((fail+1)); }
+check() { local name="$1"; shift; if "$@"; then ok "$name"; else bad "$name"; fi; }
+H=alpha.example
+pf() { printf '%s/%s/profiles.d/%s.env' "$INSTANCES_DIR" "$H" "$1"; }
+started() { grep -qx "restart twebproxy-mtproxy@$H--$1.service" "$TMP/systemctl.calls"; }
+
+c1_seed_instance "$H" 18080 18081
+c1_seed_profile "$H" alpha aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa https 23980 28980
+c1_seed_profile "$H" zeta ffffffffffffffffffffffffffffffff websocket 23981 28981
+: > "$TMP/systemctl.calls"
+
+# --- add "beta" next to "alpha" and "zeta" (beta is neither first nor last) ---
+out="$(C1_NAME=beta C1_SECRET=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb C1_CARRIER=https-lanes c1_run profile_add_cmd "$H" 2>&1)"; rc=$?
+check add_succeeds test "$rc" -eq 0
+check add_created_beta test -f "$(pf beta)"
+check add_beta_record_is_beta test "$(c1_field "$(pf beta)" PROFILE_NAME)" = beta
+check add_starts_new_backend started beta
+check add_does_not_restart_zeta bash -c '! grep -qx "restart twebproxy-mtproxy@$1--zeta.service" "$2"' _ "$H" "$TMP/systemctl.calls"
+check add_does_not_restart_alpha bash -c '! grep -qx "restart twebproxy-mtproxy@$1--alpha.service" "$2"' _ "$H" "$TMP/systemctl.calls"
+check add_reports_beta grep -q 'beta' <<<"$(grep -iE 'added|добавлен' <<<"$out")"
+check add_shows_beta_secret grep -q 'secret=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb' <<<"$out"
+check add_does_not_show_zeta bash -c '! grep -q "secret=ffffffff" <<<"$1"' _ "$out"
+check zeta_untouched test "$(c1_field "$(pf zeta)" SECRET)" = ffffffffffffffffffffffffffffffff
+check alpha_untouched test "$(c1_field "$(pf alpha)" SECRET)" = aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
+check profiles_json_three_distinct test "$(jq -r '.profiles|map(.name)|sort|join(",")' "$INSTANCES_DIR/$H/profiles.json")" = alpha,beta,zeta
+check beta_backend_env_matches test "$(c1_field "$BACKENDS_DIR/$H--beta.env" MTPROXY_SECRET)" = bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
+
+# --- rotating alpha must only touch alpha (secret) and restart only alpha ---
+: > "$TMP/systemctl.calls"
+out="$(C1_SECRET=cccccccccccccccccccccccccccccccc c1_run profile_rotate_cmd "$H" alpha 2>&1)"; rc=$?
+check rotate_succeeds test "$rc" -eq 0
+check rotate_changed_alpha test "$(c1_field "$(pf alpha)" SECRET)" = cccccccccccccccccccccccccccccccc
+check rotate_kept_alpha_name test "$(c1_field "$(pf alpha)" PROFILE_NAME)" = alpha
+check rotate_left_zeta test "$(c1_field "$(pf zeta)" SECRET)" = ffffffffffffffffffffffffffffffff
+check rotate_left_beta test "$(c1_field "$(pf beta)" SECRET)" = bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
+check rotate_restarts_alpha_only test "$(grep -c '^restart twebproxy-mtproxy@' "$TMP/systemctl.calls")" = 1
+check rotate_restarts_alpha started alpha
+check rotate_shows_alpha grep -q 'secret=cccccccccccccccccccccccccccccccc' <<<"$out"
+
+# --- carrier of zeta: only zeta changes ---
+out="$(C1_CARRIER=websocket-lanes c1_run profile_carrier_cmd "$H" zeta 2>&1)"; rc=$?
+check carrier_succeeds test "$rc" -eq 0
+check carrier_changed_zeta test "$(c1_field "$(pf zeta)" CARRIER_MODE)" = websocket-lanes
+check carrier_left_alpha test "$(c1_field "$(pf alpha)" CARRIER_MODE)" = https
+check carrier_left_beta test "$(c1_field "$(pf beta)" CARRIER_MODE)" = https-lanes
+check carrier_reports_zeta grep -q 'zeta: websocket-lanes' <<<"$out"
+
+# --- a helper that rebuilds profiles.json never moves the caller's identity ---
+# Globals as a caller holds them, then the helper, then compare.
+identity_after="$(c1_eval 'PROFILE_NAME=beta SECRET=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb BACKEND_PORT=23982
+  rebuild_profiles_json alpha.example >/dev/null 2>&1
+  printf "%s %s %s" "$PROFILE_NAME" "$SECRET" "$BACKEND_PORT"')"
+check rebuild_keeps_caller_identity test "$identity_after" = "beta bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb 23982"
+
+# --- a record whose PROFILE_NAME disagrees with its file is refused, not used ---
+sed -i 's/^PROFILE_NAME=.*/PROFILE_NAME=zeta/' "$(pf beta)"
+before="$(cat "$(pf beta)")"
+out="$(C1_SECRET=dddddddddddddddddddddddddddddddd c1_run profile_rotate_cmd "$H" beta 2>&1)"; rc=$?
+check mismatched_identity_refused test "$rc" -ne 0
+check mismatched_identity_unchanged test "$(cat "$(pf beta)")" = "$before"
+check mismatched_identity_zeta_unchanged test "$(c1_field "$(pf zeta)" SECRET)" = ffffffffffffffffffffffffffffffff
+
+# --- names from the command line are validated before any path is built ---
+out="$(C1_SECRET=dddddddddddddddddddddddddddddddd c1_run profile_rotate_cmd "$H" ../../../outside 2>&1)"; rc=$?
+check traversal_profile_refused test "$rc" -ne 0
+out="$(c1_run profile_carrier_cmd "../$H" alpha 2>&1)"; rc=$?
+check traversal_host_refused test "$rc" -ne 0
+
+printf 'c1-profile-identity: pass=%s fail=%s\n' "$pass" "$fail"
+(( fail == 0 ))
diff --git a/tests/stagec1/run-stage-c1-suite.sh b/tests/stagec1/run-stage-c1-suite.sh
